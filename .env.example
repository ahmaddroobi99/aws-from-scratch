# aws-from-scratch local environment
# Copy to .env and edit. NEVER commit real AWS keys.

# --- Application ---
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Service ports ---
FRONTEND_PORT=5173
API_PORT=8000
WORKER_PORT=8001

# --- Service URLs (inside Docker use service names) ---
API_URL=http://localhost:8000
WORKER_URL=http://localhost:8001
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# Local default: SQLite file (no extra server required)
# Docker compose overrides this to PostgreSQL.
DATABASE_URL=sqlite:///./data/cloudlab.db

# PostgreSQL equivalent (used by docker compose / AWS RDS):
# DATABASE_URL=postgresql://cloudlab:cloudlab@postgres:5432/cloudlab
POSTGRES_USER=cloudlab
POSTGRES_PASSWORD=cloudlab
POSTGRES_DB=cloudlab

# --- Queue (optional) ---
# Leave empty to use in-process background jobs.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- Storage ---
DATA_DIR=./data

# --- AWS (leave empty until you deploy) ---
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=
# Do not put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in this file.
# Use `aws configure` or an IAM role instead.
